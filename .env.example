# Leave blank to use the Vite dev proxy (recommended in development).
# Set to your deployed API origin in production, e.g. https://api.yourgym.com
VITE_API_URL=

# Who gets the staff console at /admin. Comma-separated logins (usernames or
# emails), matched case-insensitively against the account that signs in.
# Anyone else — signed out, or signed in with a login that isn't listed — sees
# the public club website instead.


#
# Leave unset to use the defaults in src/config.js ("admin" plus the club
# email). Credentials are still verified by the backend; this only picks which
# of the two UIs an authenticated account is shown.
VITE_ADMIN_LOGINS=admin,info@monkeymayhemfightclub.com
