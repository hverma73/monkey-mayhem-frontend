RewriteEngine On

# Canonical host
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Legacy HTML pages to their route equivalents
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^about-us\.html$ /team [R=301,L]
RewriteRule ^contact\.html$ /contact [R=301,L]
RewriteRule ^services\.html$ /programs [R=301,L]
RewriteRule ^gallery\.html$ / [R=301,L]
RewriteRule ^programs\.html$ /programs [R=301,L]

# SPA fallback for client-only routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# Static asset cache
<FilesMatch "^assets/.*\.(js|css|png|jpg|jpeg|webp|svg|ico|woff|woff2)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

ErrorDocument 404 /404.html
